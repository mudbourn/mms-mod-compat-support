{
  "schemaVersion": 1,
  "id": "mms_compat",
  "version": "${version}",
  "name": "MMS Mod Compat Support",
  "description": "Server-wide mod compat patches for MMSLive01. Creative-tab dedup, REI null-filter fix, creative embargo, vanity armor.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "info.mudbourn.mmscompat.MmsModCompatSupport"
    ],
    "client": [
      "info.mudbourn.mmscompat.client.MmsModCompatSupportClient"
    ],
    "server": [
      "info.mudbourn.mmscompat.dfu.DfuWarmup"
    ]
  },
  "mixins": [
    "mms_compat.mixins.json",
    "mms_compat.rei.mixins.json",
    "mms_compat.xaero.mixins.json",
    "mms_compat.apoli.mixins.json",
    "mms_compat.aerialhell.mixins.json",
    "mms_compat.mutantmonsters.mixins.json",
    "mms_compat.jei.mixins.json",
    "mms_compat.particlerain.mixins.json",
    "mms_compat.etfnbt.mixins.json",
    "mms_compat.lambdynlights.mixins.json",
    "mms_compat.rsls.mixins.json",
    "mms_compat.bubblellaneous.mixins.json",
    "mms_compat.brewinchat.mixins.json",
    "mms_compat.chatpatches.mixins.json",
    "mms_compat.lazyai.mixins.json",
    "mms_compat.alexscaves.mixins.json",
    "mms_compat.iris.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "mms_render_common": "*",
    "mms_vanity": "*",
    "mms_weapons": "*"
  },
  "suggests": {
    "mms_anim": "*",
    "mr_bubblellaneous": "*"
  }
}
